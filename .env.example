# Publishable browser configuration only; set when production Supabase is provisioned.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put service-role keys, database passwords or OAuth secrets in browser assets.

# Server only. Never add a PUBLIC_ prefix to these values.
SUPABASE_SERVICE_ROLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_APPLICATION_ID=
MERCADOPAGO_PLAN_ID=
MERCADOPAGO_MODE=test
MERCADOPAGO_TEST_BUYER_EMAIL=
# Keep false until recurring payment, cancellation and access delivery are verified.
BILLING_ENABLED=false
